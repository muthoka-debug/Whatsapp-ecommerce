# Copy to .env and fill in. .env is git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# Core Django
# ---------------------------------------------------------------------------
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite in development; set DB_ENGINE=postgresql for production.
DB_ENGINE=sqlite3
# DB_ENGINE=postgresql
# DB_NAME=whatsapp_commerce
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
# DB_CONN_MAX_AGE=60

# ---------------------------------------------------------------------------
# API behaviour
# ---------------------------------------------------------------------------
API_PAGE_SIZE=25
# Rate limits. Webhook endpoints are exempt.
THROTTLE_ANON=60/min
THROTTLE_USER=1000/hour
# Login/register brute-force cap.
THROTTLE_AUTH=10/min

# ---------------------------------------------------------------------------
# Encryption for credentials stored in the database
# ---------------------------------------------------------------------------
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes stored WhatsApp/M-Pesa credentials unrecoverable — back it up.
FIELD_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# M-Pesa (Safaricom Daraja)
# ---------------------------------------------------------------------------
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=

# Shared secret appended to callback URLs as ?token=<value>.
# Callbacks arriving without it are rejected.
MPESA_CALLBACK_SECRET=
# Optional comma-separated IP/CIDR allowlist for callbacks. Empty = no IP check.
MPESA_CALLBACK_ALLOWED_IPS=

MPESA_CALLBACK_URL=https://yourdomain.com/api/v1/payments/mpesa/callback/
MPESA_CONFIRMATION_URL=https://yourdomain.com/api/v1/payments/mpesa/c2b/confirmation/
MPESA_VALIDATION_URL=https://yourdomain.com/api/v1/payments/mpesa/c2b/validation/
MPESA_QUEUE_TIMEOUT_URL=https://yourdomain.com/api/v1/payments/mpesa/queue/
MPESA_RESULT_URL=https://yourdomain.com/api/v1/payments/mpesa/result/

# ---------------------------------------------------------------------------
# WhatsApp Business API (Meta)
# ---------------------------------------------------------------------------
# App secret from the Meta app dashboard — used to verify X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com

# Per-business credentials live in the database (WhatsAppSetting), encrypted.
# These variables are read only by `python manage.py setup_whatsapp`, which
# writes them there — keeping the token out of shell history:
#
#   python manage.py setup_whatsapp --business "Your Business"
#
# It prints the callback URL and verify token to paste into
# Meta > WhatsApp > Configuration. Re-run it any time a token is rotated.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_DISPLAY_PHONE_NUMBER=
WHATSAPP_DISPLAY_NAME=
# Public https origin of this server; /api/v1/whatsapp/webhook/ is appended.
# In development this is an ngrok tunnel: ngrok http 8000
WHATSAPP_WEBHOOK_BASE_URL=

# ---------------------------------------------------------------------------
# Redis + Celery (background processing)
#
# One Redis server; /0 is the task queue and /1 the cache. Start the workers
# alongside the web process:
#
#   celery -A core worker -l info
#   celery -A core beat -l info
#
# On Windows the default prefork pool does not work — add --pool=solo.
# ---------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
# Set to False to use Django's in-memory cache instead, so the site runs with no
# Redis installed at all. Per-process and wiped on restart — development only.
# USE_REDIS_CACHE=False
# Override only if the broker and cache live on different servers.
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# Runs tasks inline, in-process, with no worker. For tests and local
# experiments only — in production this puts the WhatsApp call back inside the
# HTTP request, which is the thing Celery is here to prevent.
CELERY_TASK_ALWAYS_EAGER=False


# ---------------------------------------------------------------------------
# Automation thresholds
# ---------------------------------------------------------------------------
# Idle hours before a cart counts as abandoned and the customer is reminded.
ABANDONED_CART_AFTER_HOURS=24
# Hours after delivery before asking the customer for feedback.
DELIVERY_FEEDBACK_AFTER_HOURS=48
# Days without an order before a customer is flagged for win-back.
CUSTOMER_INACTIVE_AFTER_DAYS=60


# ---------------------------------------------------------------------------
# Twilio (SMS, and WhatsApp as an alternative to Meta)
# ---------------------------------------------------------------------------
# Twilio is the second supported WhatsApp provider. Its sandbox gives you a
# live WhatsApp number in minutes with no Meta app review, so it is the
# quickest way to get the integration working end to end.
#
# From the Twilio Console dashboard:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Used for SMS.
TWILIO_PHONE_NUMBER=

# The WhatsApp sender. Leave as the shared sandbox number until a sender of
# your own is approved. Every phone that wants to message the sandbox must
# first send its join phrase, found under
# Twilio Console > Messaging > Try it out > Send a WhatsApp message.
TWILIO_WHATSAPP_NUMBER=+14155238886

# As with Meta, per-business credentials live in the database (WhatsAppSetting),
# encrypted. These variables are read only by:
#
#   python manage.py setup_twilio_whatsapp --business "Your Business"
#
# It checks the credentials against Twilio and prints the webhook URL to paste
# into the console. WHATSAPP_WEBHOOK_BASE_URL above is shared by both
# providers; Twilio's callback path is /api/v1/whatsapp/webhook/twilio/.
#
# Twilio authenticates its webhooks with X-Twilio-Signature, computed over the
# request URL — so WHATSAPP_WEBHOOK_BASE_URL must match the URL registered in
# the console exactly, or every inbound message is rejected as unsigned.

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
